      "id": "d66fdba1-76f5-5244-863f-c10adaf961cd",
      "name": "Telegram",
      "webhookId": "e510a0bd-474a-5875-a196-95bc818e579f"
    },
    {
      "parameters": {
        "jsCode": "// Adapta un mensaje de Telegram al formato de evento que ya entiende el Conector (el mismo de Chatwoot).\n// Asi el Conector, el backend y sus reglas no cambian: Telegram es solo otro canal de entrada.\nconst salida = [];\nfor (const item of $input.all()) {\n  const m = item.json.message || {};\n  const chat = m.chat || {};\n  if (chat.type !== 'private' || !chat.id) continue;           // solo conversaciones directas con el bot\n\n  let texto = String(m.text || '').trim();\n  if (/^\\/(start|ayuda|help)\\b/i.test(texto) || /^❓/.test(texto)) texto = 'hola';   // comandos -> bienvenida\n\n  const evento = {\n    event: 'message_created',\n    message_type: 'incoming',\n    content: texto,\n    attachments: m.location\n      ? [{ file_type: 'location', coordinates_lat: m.location.latitude, coordinates_long: m.location.longitude }]\n      : [],\n    // El backend identifica al vecino por \"telefono\": en Telegram es el id del chat (solo digitos)\n    conversation: { meta: { sender: { phone_number: String(chat.id) } } },\n  };\n  salida.push({ json: { chat_id: chat.id, data: JSON.stringify(evento) } });\n}\nreturn salida;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -380,
        0
      ],
      "id": "8917de39-54e7-569a-8209-9c150ea9edd8",
      "name": "Adaptar mensaje"
    },
