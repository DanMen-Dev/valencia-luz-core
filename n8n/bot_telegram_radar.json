        "method": "POST",
        "url": "http://localhost:5678/webhook/reporte-comunitario-luz",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ data: $json.data }) }}",
        "options": {
          "timeout": 60000
        }
      },
