        "jsCode": "// Salida del modelo: {\"zona\": \"...\"} como texto u objeto. Si no se puede leer, zona vacía.\nlet out = $input.first().json.output;\nif (typeof out === 'string') {\n  const m = out.match(/\\{[\\s\\S]*\\}/);\n  try { out = JSON.parse(m ? m[0] : out); } catch (e) { out = {}; }\n}\nconst zona = String((out && out.zona) || '').trim().slice(0, 60);\nreturn [{ json: { zona } }];\n"
