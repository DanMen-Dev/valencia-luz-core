    {
      "parameters": {
        "jsCode": "// Respuesta de POST /api/reportar/nombre\nconst r = $input.first().json;\nconst b = r.body || {};\nlet mensaje;\nif (r.statusCode === 200) {\n  const zona = String(b.zona || '').toUpperCase();\n  mensaje = b.tiene_luz === 1\n    ? `✅ Registramos que *volvió la luz* en *${zona}*. ¡Gracias por avisar!`\n    : `✅ Tu reporte de *corte* en *${zona}* ya está en el mapa.`;\n  mensaje += '\\nMapa en vivo: https://radar.brecha-cero.com/mapa';\n} else if (r.statusCode === 404) {\n  mensaje = '📍 Tu ubicación ya venció. Envíala de nuevo y luego responde con el nombre de tu sector.';\n} else if (r.statusCode === 422) {\n  mensaje = 'No entendí el nombre del sector. Escríbelo solo, por ejemplo: *Prebo* o *Si, Prebo*.';\n} else {\n  mensaje = '⚠️ No pudimos guardar tu reporte en este momento. Intenta de nuevo en unos minutos.';\n}\nreturn [{ json: { mensaje } }];\n"
      },
