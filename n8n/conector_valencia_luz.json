    {
      "parameters": {
        "jsCode": "// Lee el evento de Chatwoot (llega como texto en body.data o como objeto) y decide la ruta por reglas.\n// Rutas: ignorar | bienvenida | ubicacion | texto\nconst SALUDO = /^(hola+|ola|buenas?|buen(os|as)?\\s*(d[ií]as?|tardes?|noches?)|saludos|hey|epa|men[uú]|ayuda|inicio|info|start|\\?)[\\s!.,¡¿?]*$/i;\n\nconst salida = [];\nfor (const item of $input.all()) {\n  const body = item.json.body || {};\n  let ev = body.data !== undefined ? body.data : body;\n  if (typeof ev === 'string') {\n    try { ev = JSON.parse(ev); } catch (e) { ev = {}; }\n  }\n  ev = ev || {};\n\n  const remitente = ev.conversation?.meta?.sender || ev.sender || ev.meta?.sender || {};\n  const telefono = String(remitente.phone_number || '').replace(/\\D/g, '');\n  const texto = String(ev.content || '').trim();\n  const adjunto = (ev.attachments || []).find(a => a && a.file_type === 'location');\n  const lat = adjunto ? Number(adjunto.coordinates_lat) : null;\n  const lon = adjunto ? Number(adjunto.coordinates_long) : null;\n\n  let ruta;\n  if (ev.event !== 'message_created' || ev.message_type !== 'incoming' || !telefono) ruta = 'ignorar';\n  else if (adjunto && Number.isFinite(lat) && Number.isFinite(lon)) ruta = 'ubicacion';\n  else if (!texto || SALUDO.test(texto)) ruta = 'bienvenida';\n  else ruta = 'texto';\n\n  salida.push({ json: { ruta, telefono, texto: texto.slice(0, 300), lat, lon } });\n}\nreturn salida;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
