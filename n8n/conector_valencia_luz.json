    {
      "parameters": {
        "jsCode": "// Respuesta de POST /api/reportar/gps (respuesta completa, sin cortar el flujo por errores)\nconst r = $input.first().json;\nconst codigo = r.statusCode;\nlet mensaje;\nif (codigo === 200) {\n  mensaje = '📍 *Ubicación recibida.*\\n\\n' +\n    'Ahora responde con el nombre de tu sector (ej.: *Prebo*, *Tocuyito*, *San Diego*).\\n' +\n    'Si en tu casa *ya volvió la luz*, escribe *Si* antes del sector: *Si, Prebo*.\\n\\n' +\n    '_Tienes 10 minutos para responder._';\n} else if (codigo === 429) {\n  mensaje = '⏳ Ya recibimos varios reportes desde este número en la última hora. Intenta de nuevo más tarde.';\n} else if (codigo === 422) {\n  mensaje = '📍 Esa ubicación parece estar fuera de Venezuela. Envía la ubicación actual de tu casa.';\n} else {\n  mensaje = '⚠️ No pudimos guardar tu ubicación en este momento. Intenta de nuevo en unos minutos.';\n}\nreturn [{ json: { mensaje } }];\n"
      },
